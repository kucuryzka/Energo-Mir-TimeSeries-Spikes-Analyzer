{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "InternalConnection": "Data Source=app.db;Cache=Shared;Default Timeout=30"
  },
  "Analysis": {
    "CommandTimeoutSeconds": 86400,
    "ConnectionTimeoutSeconds": 15,
    "BatchIntervalDays": 7,
    "HangfireWorkerCount": 1,
    "HangfireJobInvisibilityTimeoutHours": 24,
    "ResultsDirectory": "results",
    "MaxAnalysisRangeDays": 3650,
    "MaxSeriesPoints": 500000,
    "ProgressSaveIntervalSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
